<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Red Baron — Aviation Crash Game (Standalone)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Cinzel:wght@700;800&family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --font-sans: "DM Sans", system-ui, -apple-system, sans-serif;
      --font-display: "Barlow Condensed", "DM Sans", sans-serif;
      --font-crest: "Cinzel", Georgia, serif;
      --font-mono: "JetBrains Mono", ui-monospace, monospace;
      --bg-main: #090d14;
      --panel-bg: linear-gradient(180deg, rgba(24, 31, 46, 0.96) 0%, rgba(14, 19, 29, 0.98) 100%);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      background: var(--bg-main);
      color: #f1f5f9;
      font-family: var(--font-sans);
      min-height: 100%;
      overscroll-behavior-y: contain;
    }

    button, input, select { font-family: inherit; }
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
    input[type="number"] { -moz-appearance: textfield; }

    .tabular-nums { font-variant-numeric: tabular-nums; }

    /* Scrollbar */
    .rb-scroll::-webkit-scrollbar { width: 5px; height: 5px; }
    .rb-scroll::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.5); }
    .rb-scroll::-webkit-scrollbar-thumb { background: rgba(148, 163, 184, 0.25); border-radius: 9999px; }
    .rb-scroll::-webkit-scrollbar-thumb:hover { background: rgba(225, 29, 72, 0.55); }

    /* Boot Loader */
    @keyframes evo-star-spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    #boot-loader {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background: linear-gradient(123deg, #414650 -20.53%, #050a0a 101.67%);
      transition: opacity 0.3s ease;
      cursor: pointer;
      user-select: none;
    }

    #boot-loader.hidden { opacity: 0; pointer-events: none; }

    .loader-box { width: 100%; max-width: 320px; display: flex; flex-direction: column; align-items: center; }

    .loader-crest {
      width: 64px; height: 64px; border-radius: 16px;
      background: linear-gradient(135deg, #e11d48, #881337);
      border: 1px solid rgba(251, 113, 133, 0.35);
      box-shadow: 0 0 32px rgba(225, 29, 72, 0.45);
      display: flex; align-items: center; justify-content: center; margin-bottom: 12px;
    }

    .loader-title {
      font-family: var(--font-crest); font-size: 24px; font-weight: 800;
      letter-spacing: 0.18em; color: #fff; text-transform: uppercase;
    }

    .loader-sub {
      font-size: 11px; font-weight: 600; letter-spacing: 0.28em;
      color: rgba(251, 191, 36, 0.9); text-transform: uppercase; margin-top: 4px; margin-bottom: 28px;
    }

    .loader-track {
      width: 100%; height: 5px; border-radius: 9999px;
      background: rgba(255, 255, 255, 0.15); overflow: hidden;
    }

    .loader-fill {
      height: 100%; border-radius: 9999px; width: 12%;
      background: linear-gradient(270deg, #82e620 0%, #78be20 100%);
      transition: width 75ms linear;
    }

    .loader-status {
      margin-top: 18px; display: flex; align-items: center; gap: 10px;
      font-size: 12px; font-weight: 500; letter-spacing: 0.08em;
      text-transform: uppercase; color: #cbd5e1;
    }

    .loader-star { width: 18px; height: 18px; color: #82e620; animation: evo-star-spin 1.8s linear infinite; }

    /* Header */
    .app-header {
      position: sticky; top: 0; z-index: 30;
      background: rgba(13, 18, 28, 0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .header-inner {
      max-width: 1520px; margin: 0 auto; padding: 0 14px; height: 56px;
      display: flex; align-items: center; justify-content: space-between; gap: 10px;
    }

    .brand { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .brand-icon {
      width: 36px; height: 36px; border-radius: 11px; flex-shrink: 0;
      background: linear-gradient(135deg, #e11d48, #9f1239);
      border: 1px solid rgba(251, 113, 133, 0.35);
      box-shadow: 0 0 18px rgba(225, 29, 72, 0.35);
      display: flex; align-items: center; justify-content: center;
    }

    .brand-title-row { display: flex; align-items: center; gap: 8px; }
    .brand-title {
      font-family: var(--font-crest); font-size: 17px; font-weight: 800;
      letter-spacing: 0.12em; color: #fff; text-transform: uppercase;
    }
    .brand-badge {
      display: none; border-radius: 4px; background: rgba(225, 29, 72, 0.2);
      border: 1px solid rgba(244, 63, 94, 0.35); padding: 2px 6px;
      font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #fda4af;
    }
    .brand-sub { display: none; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: #94a3b8; }

    .header-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

    .btn-wallet {
      display: flex; align-items: center; gap: 8px; border-radius: 12px;
      background: #0f172a; border: 1px solid rgba(16, 185, 129, 0.3);
      padding: 6px 12px; color: #6ee7b7; font-family: var(--font-mono);
      font-size: 13px; font-weight: 700; cursor: pointer; transition: background 0.15s;
    }
    .btn-wallet:hover { background: #1e293b; }

    .btn-icon {
      width: 36px; height: 36px; border-radius: 12px;
      background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);
      color: #e2e8f0; display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: background 0.15s;
    }
    .btn-icon:hover { background: rgba(255, 255, 255, 0.1); }

    /* Main Grid */
    .main-wrap { max-width: 1520px; width: 100%; margin: 0 auto; padding: 14px; }
    .arena-grid { display: grid; grid-template-columns: 1fr; gap: 14px; align-items: start; }
    .left-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }

    /* History Strip */
    .history-bar {
      background: rgba(17, 23, 35, 0.95); border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px; padding: 8px 12px;
    }
    .history-row { display: flex; align-items: center; gap: 8px; }
    .history-label {
      display: none; align-items: center; gap: 6px; font-size: 11px; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.08em; color: #94a3b8; flex-shrink: 0;
    }
    .history-pills { flex: 1; display: flex; align-items: center; gap: 6px; overflow-x: auto; padding: 2px 0; }
    .pill {
      flex-shrink: 0; padding: 4px 10px; border-radius: 8px; border: 1px solid transparent;
      font-family: var(--font-mono); font-size: 12px; font-weight: 700; cursor: pointer;
      background: transparent; transition: filter 0.15s;
    }
    .pill:hover { filter: brightness(1.22); }
    .pill-low { background: rgba(14, 165, 233, 0.14); color: #7dd3fc; border-color: rgba(56, 189, 248, 0.25); }
    .pill-mid { background: rgba(16, 185, 129, 0.16); color: #6ee7b7; border-color: rgba(52, 211, 153, 0.35); }
    .pill-high { background: rgba(245, 158, 11, 0.18); color: #fcd34d; border-color: rgba(251, 191, 36, 0.4); box-shadow: 0 0 12px rgba(245, 158, 11, 0.18); }
    .pill-latest { box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.35); }

    .btn-expand {
      flex-shrink: 0; display: flex; align-items: center; gap: 4px;
      border-radius: 8px; background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1); padding: 6px 10px;
      font-size: 12px; font-weight: 600; color: #e2e8f0; cursor: pointer;
    }
    .btn-expand:hover { background: rgba(255, 255, 255, 0.1); }
    .history-drawer { display: none; margin-top: 10px; padding-top: 10px; border-top: 1px solid rgba(255, 255, 255, 0.1); }
    .history-drawer.open { display: block; }
    .history-drawer-grid { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }

    /* Flight Canvas Stage */
    .stage-box {
      position: relative; width: 100%; height: 260px; border-radius: 16px;
      overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.1);
      background: #0b101b; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
      user-select: none;
    }
    #flight-canvas { display: block; width: 100%; height: 100%; }

    .stage-telemetry {
      pointer-events: none; position: absolute; top: 12px; left: 12px;
      display: flex; align-items: center; gap: 8px; border-radius: 8px;
      background: rgba(2, 6, 23, 0.72); backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.1); padding: 4px 10px;
      font-size: 11px; font-weight: 600; color: #cbd5e1;
    }

    .stage-hud {
      pointer-events: none; position: absolute; inset: 0;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 16px; text-align: center;
    }

    .hud-card {
      display: flex; flex-direction: column; align-items: center;
      background: rgba(2, 6, 23, 0.7); backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 16px;
      padding: 16px 26px; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    }
    .hud-card.crashed { border-color: rgba(244, 63, 94, 0.45); box-shadow: 0 0 40px rgba(225, 29, 72, 0.35); }

    .hud-tag { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.22em; margin-bottom: 4px; }
    .hud-mult {
      font-family: var(--font-display); font-size: 56px; font-weight: 800;
      line-height: 1; letter-spacing: -0.02em; color: #ffffff;
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.85);
    }
    .hud-mult.tier-mid { color: #34d399; text-shadow: 0 0 24px rgba(16, 185, 129, 0.45); }
    .hud-mult.tier-high { color: #fbbf24; text-shadow: 0 0 28px rgba(251, 191, 36, 0.55); }
    .hud-mult.tier-crash { color: #f43f5e; text-shadow: 0 0 24px rgba(244, 63, 94, 0.65); }

    .countdown-track {
      margin-top: 12px; width: 190px; height: 8px; border-radius: 9999px;
      background: rgba(255, 255, 255, 0.1); overflow: hidden;
    }
    .countdown-fill {
      height: 100%; border-radius: 9999px;
      background: linear-gradient(90deg, #f43f5e, #fbbf24, #34d399);
    }

    .win-popups {
      pointer-events: none; position: absolute; top: 12px; right: 12px;
      display: flex; flex-direction: column; gap: 8px; align-items: flex-end;
    }
    .win-toast {
      display: flex; align-items: center; gap: 8px; border-radius: 12px;
      background: rgba(16, 185, 129, 0.96); color: #020617; font-weight: 700;
      padding: 7px 12px; font-size: 13px; border: 1px solid rgba(110, 231, 183, 0.6);
      box-shadow: 0 8px 24px rgba(16, 185, 129, 0.45);
    }

    /* 3 Bet Panels Grid */
    .bets-grid { display: grid; grid-template-columns: 1fr; gap: 12px; }

    .bet-card {
      background: var(--panel-bg);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      padding: 13px;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 12px 28px -8px rgba(0, 0, 0, 0.65);
      transition: border-color 0.2s;
    }
    .bet-card.st-flying { border-color: rgba(251, 191, 36, 0.45); }
    .bet-card.st-cashed { border-color: rgba(52, 211, 153, 0.45); }
    .bet-card.st-placed, .bet-card.st-queued { border-color: rgba(244, 63, 94, 0.42); }

    .bet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
    .slot-badge {
      border-radius: 6px; background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.1); padding: 2px 8px;
      font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #cbd5e1;
    }
    .mode-switch {
      display: inline-flex; border-radius: 8px; background: rgba(2, 6, 23, 0.8);
      padding: 2px; border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .mode-btn {
      padding: 4px 10px; border-radius: 6px; border: none; background: transparent;
      font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
      color: #94a3b8; cursor: pointer;
    }
    .mode-btn.active { background: #e11d48; color: #ffffff; }

    .bet-body { display: grid; grid-template-columns: 7fr 5fr; gap: 10px; align-items: stretch; }
    .bet-inputs { display: flex; flex-direction: column; gap: 8px; }

    .stepper {
      display: flex; align-items: center; border-radius: 12px;
      background: rgba(2, 6, 23, 0.85); border: 1px solid rgba(255, 255, 255, 0.1); padding: 4px 6px;
    }
    .step-btn {
      width: 30px; height: 30px; border-radius: 8px; border: none;
      background: rgba(255, 255, 255, 0.06); color: #e2e8f0;
      font-size: 15px; font-weight: 700; cursor: pointer; flex-shrink: 0;
    }
    .step-btn:hover:not(:disabled) { background: rgba(255, 255, 255, 0.14); }
    .step-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .stake-input-wrap { flex: 1; display: flex; align-items: center; justify-content: center; gap: 2px; min-width: 0; }
    .stake-input {
      width: 100%; background: transparent; border: none; text-align: center;
      font-family: var(--font-mono); font-size: 14px; font-weight: 700; color: #fff; outline: none;
    }

    .chips-row { display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px; }
    .chip-btn {
      padding: 6px 0; border-radius: 8px; background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.08); color: #cbd5e1;
      font-family: var(--font-mono); font-size: 11px; font-weight: 700; cursor: pointer;
    }
    .chip-btn:hover:not(:disabled) { background: rgba(255, 255, 255, 0.12); }
    .chip-btn.selected { background: rgba(225, 29, 72, 0.25); border-color: rgba(244, 63, 94, 0.6); color: #fecdd3; }
    .chip-btn:disabled { opacity: 0.4; cursor: not-allowed; }

    .action-btn {
      width: 100%; min-height: 68px; border-radius: 12px; border: 1px solid transparent;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 8px; cursor: pointer; transition: transform 0.1s, filter 0.15s;
    }
    .action-btn:active:not(:disabled) { transform: scale(0.98); }
    .action-btn:disabled { opacity: 0.65; cursor: not-allowed; }
    .action-btn.btn-bet {
      background: linear-gradient(180deg, #34d399, #059669);
      border-color: rgba(110, 231, 183, 0.6); color: #020617;
      box-shadow: 0 6px 20px rgba(16, 185, 129, 0.35);
    }
    .action-btn.btn-cashout {
      background: linear-gradient(180deg, #fcd34d, #f59e0b);
      border-color: rgba(253, 230, 138, 0.8); color: #020617;
      box-shadow: 0 8px 28px rgba(245, 158, 11, 0.45);
    }
    .action-btn.btn-cancel {
      background: linear-gradient(180deg, #f43f5e, #be123c);
      border-color: rgba(251, 113, 133, 0.5); color: #ffffff;
      box-shadow: 0 6px 20px rgba(225, 29, 72, 0.35);
    }
    .action-btn.btn-locked {
      background: #334155; border-color: rgba(148, 163, 184, 0.3); color: #e2e8f0;
    }
    .action-title { font-family: var(--font-display); font-size: 20px; font-weight: 800; text-transform: uppercase; line-height: 1; }
    .action-sub { margin-top: 4px; font-family: var(--font-mono); font-size: 12px; font-weight: 700; }

    .bet-foot {
      margin-top: 10px; padding-top: 10px; border-top: 1px solid rgba(255, 255, 255, 0.08);
      display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px;
    }
    .auto-toggle {
      display: inline-flex; align-items: center; gap: 5px; border-radius: 8px;
      padding: 4px 8px; font-size: 11px; font-weight: 600; cursor: pointer;
      background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: #94a3b8;
    }
    .auto-toggle.on { background: rgba(245, 158, 11, 0.2); border-color: rgba(251, 191, 36, 0.5); color: #fcd34d; }

    .target-box {
      display: flex; align-items: center; border-radius: 8px;
      background: rgba(2, 6, 23, 0.9); border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 4px 8px; width: 78px;
    }
    .target-input {
      width: 100%; background: transparent; border: none; text-align: right;
      font-family: var(--font-mono); font-size: 12px; font-weight: 700; color: #fff; outline: none;
    }
    .target-input:disabled { opacity: 0.4; }

    .autobet-controls { display: none; align-items: center; gap: 6px; }
    .autobet-controls.visible { display: flex; }
    .rounds-select {
      border-radius: 8px; background: #020617; border: 1px solid rgba(255, 255, 255, 0.12);
      padding: 4px 6px; font-size: 11px; font-weight: 600; color: #e2e8f0; outline: none;
    }
    .autobet-btn {
      border-radius: 8px; padding: 4px 10px; font-size: 11px; font-weight: 700; cursor: pointer;
      background: rgba(16, 185, 129, 0.2); color: #6ee7b7; border: 1px solid rgba(52, 211, 153, 0.4);
    }
    .autobet-btn.active { background: #e11d48; color: #fff; border-color: rgba(251, 113, 133, 0.5); }

    /* Live Sidebar */
    .sidebar {
      background: var(--panel-bg); border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px; display: flex; flex-direction: column;
      height: 360px; overflow: hidden;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 12px 28px -8px rgba(0, 0, 0, 0.65);
    }
    .sidebar-tabs {
      padding: 10px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px;
      background: rgba(2, 6, 23, 0.45);
    }
    .tab-btn {
      padding: 7px 6px; border-radius: 8px; border: none; background: transparent;
      font-size: 12px; font-weight: 600; color: #94a3b8; cursor: pointer;
    }
    .tab-btn.active { background: #e11d48; color: #fff; }
    .sidebar-meta {
      padding: 8px 14px; background: rgba(2, 6, 23, 0.45);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      display: flex; align-items: center; justify-content: space-between;
      font-size: 11px; color: #94a3b8;
    }
    .feed-head {
      display: grid; grid-template-columns: 5fr 3fr 4fr; padding: 8px 14px;
      font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
      color: #64748b; border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .feed-list { flex: 1; overflow-y: auto; padding: 4px 8px; }
    .feed-row {
      display: grid; grid-template-columns: 5fr 3fr 4fr; align-items: center;
      padding: 7px 8px; border-radius: 8px; font-size: 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }
    .feed-row.won { background: rgba(16, 185, 129, 0.1); }
    .feed-row.lost { opacity: 0.5; }
    .pilot-cell { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .pilot-avatar {
      width: 20px; height: 20px; border-radius: 9999px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 10px; font-weight: 700; color: #fff;
    }
    .pilot-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; color: #e2e8f0; }

    /* Modals */
    .modal-backdrop {
      position: fixed; inset: 0; z-index: 60; display: none;
      align-items: center; justify-content: center; padding: 16px;
      background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(4px);
    }
    .modal-backdrop.open { display: flex; }
    .modal-box {
      width: 100%; max-width: 460px; border-radius: 16px;
      background: var(--panel-bg); border: 1px solid rgba(255, 255, 255, 0.15);
      padding: 20px; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.75);
    }
    .modal-head {
      display: flex; align-items: center; justify-content: space-between;
      padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .modal-title { font-family: var(--font-display); font-size: 20px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
    .modal-close {
      width: 30px; height: 30px; border-radius: 8px; border: none;
      background: rgba(255, 255, 255, 0.08); color: #cbd5e1; cursor: pointer; font-weight: 700;
    }

    @media (min-width: 640px) {
      .stage-box { height: 320px; }
      .hud-mult { font-size: 72px; }
      .brand-sub { display: block; }
      .history-label { display: inline-flex; }
    }

    @media (min-width: 768px) {
      .bets-grid { grid-template-columns: repeat(3, 1fr); }
      .brand-badge { display: inline-block; }
    }

    @media (min-width: 1024px) {
      .stage-box { height: 370px; }
      .hud-mult { font-size: 88px; }
      .arena-grid { grid-template-columns: 9fr 3fr; }
      .sidebar { height: 650px; position: sticky; top: 72px; }
    }
  </style>
</head>
<body>
  <!-- Boot Loader -->
  <div id="boot-loader">
    <div class="loader-box">
      <div class="loader-crest">
        <svg viewBox="0 0 64 64" width="38" height="38" fill="none">
