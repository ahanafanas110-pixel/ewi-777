        if (!myBets.length) {
          feedList.innerHTML = `<div style="text-align:center;padding:42px 16px;font-size:12px;color:#64748b;">No flights logged yet. Place a bet to track payouts.</div>`;
        } else {
          feedList.innerHTML = myBets.map((m) => `<div class="feed-row ${m.won ? 'won' : ''}">
            <div class="pilot-cell"><span style="font-family:var(--font-mono);color:#94a3b8;">#${m.roundId}</span><span style="padding:1px 6px;border-radius:4px;background:rgba(255,255,255,0.08);font-size:10px;font-weight:700;">B${m.slotId + 1}</span></div>
            <div class="tabular-nums" style="text-align:right;font-family:var(--font-mono);">€${m.stake.toFixed(2)}</div>
            <div class="tabular-nums" style="text-align:right;font-family:var(--font-mono);">${m.won ? `<span style="color:#34d399;font-weight:700;display:block;">+€${m.payout.toFixed(2)}</span><span style="font-size:10px;color:#6ee7b7;">@${m.mult.toFixed(2)}x</span>` : `<span style="color:#fda4af;font-size:11px;">Crash @${m.cp.toFixed(2)}x</span>`}</div>
          </div>`).join('');
        }
      } else {
        const top = bots.filter((b) => b.payout !== null).sort((a, b) => b.payout - a.payout);
        if (!top.length) {
          feedList.innerHTML = `<div style="text-align:center;padding:42px 16px;font-size:12px;color:#64748b;">Waiting for first cashouts in this round.</div>`;
        } else {
          feedList.innerHTML = top.map((p, i) => `<div class="feed-row won">
            <div class="pilot-cell"><span style="color:#fbbf24;font-family:var(--font-mono);font-weight:700;">#${i + 1}</span><span class="pilot-name">${p.name}</span></div>
            <div class="tabular-nums" style="text-align:right;font-family:var(--font-mono);">€${p.stake}</div>
            <div class="tabular-nums" style="text-align:right;font-family:var(--font-mono);"><span style="color:#fcd34d;font-weight:700;display:block;">€${p.payout.toFixed(2)}</span><span style="font-size:10px;color:#34d399;">${p.cashedAt.toFixed(2)}x</span></div>
          </div>`).join('');
        }
      }
    }

    // --- Canvas Renderer ---
    const canvas = document.getElementById('flight-canvas');
    const stageBox = document.getElementById('stage-box');
    const ctx = canvas.getContext('2d');
    const clouds = Array.from({ length: 14 }, (_, i) => ({ x: (i / 14) * 1.3, y: 0.1 + Math.random() * 0.65, scale: 0.55 + Math.random() * 0.85, speed: 0.018 + Math.random() * 0.032, opacity: 0.16 + Math.random() * 0.28 }));
    const stars = Array.from({ length: 55 }, () => ({ x: Math.random(), y: Math.random() * 0.85, size: 0.8 + Math.random() * 1.8, alpha: 0.3 + Math.random() * 0.7 }));
    let particles = [], runwayScroll = 0;

    function resizeCanvas() {
      const r = stageBox.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(300, Math.floor(r.width * dpr));
      canvas.height = Math.max(200, Math.floor(r.height * dpr));
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    function lerp(a, b, t) { return a + (b - a) * Math.max(0, Math.min(1, t)); }
    function lerpCol(c1, c2, t) {
      const cl = Math.max(0, Math.min(1, t));
      return `rgb(${Math.round(lerp(c1[0], c2[0], cl))},${Math.round(lerp(c1[1], c2[1], cl))},${Math.round(lerp(c1[2], c2[2], cl))})`;
    }

    function drawBiplane(x, y, ang, sc, propP, scarfP) {
      ctx.save(); ctx.translate(x, y); ctx.rotate(ang); ctx.scale(sc, sc);
      const glow = ctx.createRadialGradient(34, 0, 2, 34, 0, 32);
      glow.addColorStop(0, 'rgba(251,191,36,0.45)'); glow.addColorStop(1, 'rgba(225,29,72,0)');
      ctx.fillStyle = glow; ctx.beginPath(); ctx.arc(34, 0, 32, 0, Math.PI * 2); ctx.fill();

      ctx.strokeStyle = '#334155'; ctx.lineWidth = 2.4;
      ctx.beginPath(); ctx.moveTo(-26, 6); ctx.lineTo(-32, 13); ctx.moveTo(8, 8); ctx.lineTo(14, 21); ctx.moveTo(22, 8); ctx.lineTo(14, 21); ctx.stroke();
      ctx.fillStyle = '#0f172a'; ctx.beginPath(); ctx.arc(14, 22, 6, 0, Math.PI * 2); ctx.fill();

      ctx.strokeStyle = '#f8fafc'; ctx.lineWidth = 3.2; ctx.lineCap = 'round';
      ctx.beginPath(); ctx.moveTo(-6, -8); ctx.quadraticCurveTo(-18, -11 + Math.sin(scarfP) * 4, -30, -7 + Math.cos(scarfP * 1.4) * 5); ctx.stroke();

      ctx.fillStyle = '#be123c';
      ctx.beginPath(); ctx.moveTo(-36, 0); ctx.lineTo(-42, -16); ctx.quadraticCurveTo(-30, -17, -24, -4); ctx.closePath(); ctx.fill();

      const bg = ctx.createLinearGradient(-38, -10, 34, 10);
      bg.addColorStop(0, '#9f1239'); bg.addColorStop(0.55, '#e11d48'); bg.addColorStop(1, '#fb7185');
      ctx.fillStyle = bg;
      ctx.beginPath(); ctx.moveTo(-36, -3); ctx.quadraticCurveTo(-12, -10, 28, -9); ctx.lineTo(35, -6); ctx.lineTo(35, 7); ctx.quadraticCurveTo(10, 11, -36, 4); ctx.closePath(); ctx.fill();

      ctx.fillStyle = '#451a03'; ctx.beginPath(); ctx.arc(-4, -9, 5.2, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = '#fbbf24'; ctx.fillRect(-2, -11.5, 4, 2.4);

      ctx.fillStyle = '#94a3b8'; ctx.beginPath(); ctx.roundRect(26, -8.5, 9, 16.5, 3); ctx.fill();
      ctx.fillStyle = '#9f1239'; ctx.beginPath(); ctx.roundRect(2, 4, 22, 4.2, 2); ctx.fill();
      ctx.fillStyle = '#be123c'; ctx.beginPath(); ctx.roundRect(5, -5, 23, 4.2, 2); ctx.fill();
      ctx.strokeStyle = '#1e293b'; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(10, -15); ctx.lineTo(7, 6); ctx.moveTo(23, -15); ctx.lineTo(20, 6); ctx.stroke();
      ctx.fillStyle = '#f43f5e'; ctx.beginPath(); ctx.roundRect(3, -19.5, 28, 5.2, 2.5); ctx.fill();

      ctx.save(); ctx.translate(38, 0);
      ctx.fillStyle = 'rgba(226,232,240,0.22)'; ctx.beginPath(); ctx.ellipse(0, 0, 2.8, 20, 0, 0, Math.PI * 2); ctx.fill();
      const bLen = 19 * Math.sin(propP);
      ctx.strokeStyle = '#f8fafc'; ctx.lineWidth = 2.6; ctx.beginPath(); ctx.moveTo(0, -bLen); ctx.lineTo(0, bLen); ctx.stroke();
      ctx.fillStyle = '#f59e0b'; ctx.beginPath(); ctx.arc(-1, 0, 3.2, 0, Math.PI * 2); ctx.fill();
      ctx.restore();
      ctx.restore();
    }

    function updateHud(betPct, secLeft) {
      roundLabel.textContent = `ROUND #${roundId}`;
      if (phase === 'BETTING') {
        phaseLabel.textContent = 'Runway Ready';
        stageHud.innerHTML = `<div class="hud-card"><span class="hud-tag" style="color:#fbbf24;">Place Your Bets</span><div class="hud-mult tabular-nums" style="font-size:46px;">${secLeft.toFixed(1)}s</div><div class="countdown-track"><div class="countdown-fill" style="width:${Math.max(0, Math.min(100, betPct * 100))}%"></div></div><span style="margin-top:8px;font-size:11px;color:#94a3b8;">Next flight preparing on runway</span></div>`;
      } else if (phase === 'TAKEOFF') {
        phaseLabel.textContent = 'Full Throttle';
        stageHud.innerHTML = `<div><span class="hud-tag" style="color:#fcd34d;display:block;">Engines Roaring</span><div class="hud-mult tabular-nums">1.00x</div></div>`;
      } else if (phase === 'FLYING') {
        phaseLabel.textContent = 'Airborne';
        const tier = multiplier >= 10 ? 'tier-high' : multiplier >= 2 ? 'tier-mid' : '';
        stageHud.innerHTML = `<div class="hud-mult tabular-nums ${tier}">${multiplier.toFixed(2)}x</div>`;
      } else {
        phaseLabel.textContent = 'Flew Away';
        stageHud.innerHTML = `<div class="hud-card crashed"><span class="hud-tag" style="color:#fb7185;">Flew Away!</span><div class="hud-mult tier-crash tabular-nums">${multiplier.toFixed(2)}x</div></div>`;
      }
    }

    initBetCards();
    renderHistory();
    renderSidebar();
    renderBetCards();

    let lastFrame = performance.now();
    function loop(now) {
      const dt = Math.min(0.05, (now - lastFrame) / 1000);
      lastFrame = now;
      const elapsed = now - phaseStart;

      if (phase === 'BETTING') {
        const rem = Math.max(0, BETTING_MS - elapsed);
        updateHud(rem / BETTING_MS, Math.ceil(rem / 100) / 10);
        if (elapsed >= BETTING_MS) {
          phase = 'TAKEOFF'; phaseStart = now; takeoffProg = 0;
          Sound.playTakeoff();
          slots.forEach((s) => { if (s.status === 'PLACED') s.status = 'FLYING'; });
          renderBetCards();
        }
      } else if (phase === 'TAKEOFF') {
        takeoffProg = Math.min(1, elapsed / TAKEOFF_MS);
        updateHud(0, 0);
        if (elapsed >= TAKEOFF_MS) {
          phase = 'FLYING'; phaseStart = now; flightElapsed = 0; multiplier = 1.0;
          if (crashPoint <= 1.0) {
            phase = 'CRASHED'; phaseStart = now; crashElapsed = 0;
            Sound.playFlyAway();
            slots.forEach((s) => {
              if (s.status === 'FLYING') {
                s.status = 'LOST';
                myBets.unshift({ roundId, slotId: s.id, stake: s.stake, mult: null, payout: 0, cp: 1.0, won: false });
              }
            });
            history.unshift({ roundId, cp: 1.0 }); if (history.length > 50) history.pop();
            renderHistory(); renderBetCards(); renderSidebar();
          } else {
            renderBetCards();
          }
        }
      } else if (phase === 'FLYING') {
        flightElapsed = elapsed;
        const raw = Math.exp(GROWTH * (elapsed / 1000));
        const curM = Math.min(crashPoint, Math.floor(raw * 100) / 100);
        if (curM !== multiplier) {
          multiplier = curM;
          Sound.updatePitch(curM);
          slots.forEach((s) => {
            if (s.status === 'FLYING' && s.autoCash && curM >= s.target && s.target <= crashPoint) {
              cashOutSlot(s.id, s.target);
            }
          });
          let botChanged = false;
          bots.forEach((b) => {
            if (b.cashedAt === null && b.target !== null && curM >= b.target && b.target <= crashPoint) {
              b.cashedAt = b.target; b.payout = +(b.stake * b.target).toFixed(2); botChanged = true;
            }
          });
          if (botChanged) renderSidebar();
          slots.forEach((s) => {
            if (s.status === 'FLYING') {
              document.getElementById(`action-sub-${s.id}`).textContent = `€${(s.stake * multiplier).toFixed(2)}`;
            }
          });
        }
        updateHud(0, 0);

        if (raw >= crashPoint) {
          multiplier = crashPoint;
          phase = 'CRASHED'; phaseStart = now; crashElapsed = 0;
          Sound.playFlyAway();
          slots.forEach((s) => {
            if (s.status === 'FLYING') {
              s.status = 'LOST';
              myBets.unshift({ roundId, slotId: s.id, stake: s.stake, mult: null, payout: 0, cp: crashPoint, won: false });
            }
          });
          if (myBets.length > 50) myBets.length = 50;
          history.unshift({ roundId, cp: crashPoint }); if (history.length > 50) history.pop();
          updateHud(0, 0); renderHistory(); renderBetCards(); renderSidebar();
        }
      } else if (phase === 'CRASHED') {
        crashElapsed = elapsed;
        if (elapsed >= CRASHED_MS) {
          roundId += 1; crashPoint = genCrashPoint(); multiplier = 1.0;
          flightElapsed = 0; crashElapsed = 0; bots = genBots(crashPoint);
          slots.forEach((s) => {
            if (s.status === 'QUEUED') { s.status = 'PLACED'; s.cashedMult = null; s.payout = null; }
            else if (s.autoBet) {
              const okRounds = s.roundsLeft === 0 || s.roundsLeft >= 1;
              if (s.stake <= balance && okRounds) {
                setBalance(balance - s.stake);
                s.status = 'PLACED'; s.cashedMult = null; s.payout = null;
                const keep = s.roundsLeft === 0 || s.roundsLeft > 1;
                s.roundsLeft = s.roundsLeft > 0 ? s.roundsLeft - 1 : 0;
                s.autoBet = keep;
              } else { s.status = 'IDLE'; s.autoBet = false; s.roundsLeft = 0; }
            } else { s.status = 'IDLE'; s.cashedMult = null; s.payout = null; }
          });
          phase = 'BETTING'; phaseStart = now;
          renderBetCards(); renderSidebar();
        }
      }

      // --- Canvas Render ---
      const w = canvas.width, h = canvas.height, dpr = Math.min(window.devicePixelRatio || 1, 2);
      const padL = 42 * dpr, padR = 26 * dpr, padT = 24 * dpr, padB = 34 * dpr, groundY = h - padB;
      ctx.clearRect(0, 0, w, h);

      const alt = (phase === 'FLYING' || phase === 'CRASHED') ? Math.min(1, Math.log10(Math.max(1, multiplier)) / 1.65) : 0;
      const sg = ctx.createLinearGradient(0, 0, 0, h);
      sg.addColorStop(0, lerpCol([16,24,42],[10,7,24], alt));
      sg.addColorStop(0.58, lerpCol([31,46,78],[58,17,44], alt));
      sg.addColorStop(1, lerpCol([89,52,62],[22,28,45], alt));
      ctx.fillStyle = sg; ctx.fillRect(0, 0, w, h);

      const sAlpha = Math.max(0, (alt - 0.25) / 0.75);
      if (sAlpha > 0.02) {
        stars.forEach((st) => {
          ctx.fillStyle = `rgba(255,255,255,${st.alpha * sAlpha})`;
          ctx.beginPath(); ctx.arc(st.x * w, st.y * h, st.size * dpr, 0, Math.PI * 2); ctx.fill();
        });
      }

      const sunY = groundY + alt * h * 0.45;
      const sunG = ctx.createRadialGradient(w * 0.72, sunY, 10, w * 0.72, sunY, h * 0.65);
      sunG.addColorStop(0, `rgba(245, 158, 11, ${0.22 * (1 - alt * 0.8)})`);
      sunG.addColorStop(0.45, `rgba(225, 29, 72, ${0.14 * (1 - alt * 0.7)})`);
      sunG.addColorStop(1, 'rgba(15, 23, 42, 0)');
      ctx.fillStyle = sunG; ctx.fillRect(0, 0, w, h);

      const cloudSpd = phase === 'BETTING' ? 0.35 : phase === 'TAKEOFF' ? 1.4 : phase === 'FLYING' ? 2.2 + Math.min(4.5, Math.log2(Math.max(1, multiplier))) : 1.5;
      clouds.forEach((c) => {
        c.x -= c.speed * cloudSpd * dt;
        if (c.x < -0.25) { c.x = 1.2; c.y = 0.08 + Math.random() * 0.65; }
        ctx.save(); ctx.translate(c.x * w, c.y * h); ctx.scale(c.scale * dpr * 0.85, c.scale * dpr * 0.85);
        ctx.fillStyle = `rgba(241,245,249,${c.opacity * (1 - alt * 0.35)})`;
        ctx.beginPath(); ctx.arc(0,0,28,0,Math.PI*2); ctx.arc(24,-8,22,0,Math.PI*2); ctx.arc(46,2,20,0,Math.PI*2); ctx.arc(-22,5,19,0,Math.PI*2); ctx.fill();
        ctx.restore();
      });

      ctx.strokeStyle = 'rgba(255,255,255,0.06)'; ctx.lineWidth = 1 * dpr;
      ctx.setLineDash([4 * dpr, 6 * dpr]);
      for (let i = 1; i <= 4; i++) {
        const gy = lerp(groundY, padT, i / 4.5);
        ctx.beginPath(); ctx.moveTo(padL, gy); ctx.lineTo(w - padR, gy); ctx.stroke();
      }
      ctx.setLineDash([]);

      const rDrop = phase === 'FLYING' ? Math.min(h * 0.38, (flightElapsed / 1000) * 28 * dpr) : phase === 'CRASHED' ? h * 0.38 : 0;
      const rY = groundY + rDrop;
      if (rY < h + 40 * dpr) {
        ctx.fillStyle = '#0f172a'; ctx.fillRect(0, rY, w, h - rY + 40 * dpr);
        ctx.fillStyle = '#1e293b'; ctx.fillRect(0, rY, w, 14 * dpr);
        if (phase === 'TAKEOFF') runwayScroll += dt * 420 * takeoffProg;
        else if (phase === 'BETTING') runwayScroll = 0;
        const sp = 44 * dpr, off = (runwayScroll * dpr) % sp;
        ctx.fillStyle = 'rgba(248,250,252,0.55)';
        for (let rx = -sp; rx < w + sp; rx += sp) ctx.fillRect(rx - off, rY + 5.5 * dpr, 22 * dpr, 2.5 * dpr);
        for (let lx = padL; lx < w - padR; lx += 75 * dpr) {
          ctx.fillStyle = phase === 'BETTING' ? '#22c55e' : 'rgba(245,158,11,0.8)';
          ctx.beginPath(); ctx.arc(lx, rY + 1.5 * dpr, 2 * dpr, 0, Math.PI * 2); ctx.fill();
        }
      }

      ctx.fillStyle = 'rgba(148,163,184,0.6)';
      ctx.font = `600 ${10 * dpr}px "JetBrains Mono", monospace`;
      ctx.textAlign = 'right';
      const baseAxisMax = Math.max(2.0, multiplier * 1.15);
      for (let i = 0; i <= 4; i++) {
        const val = 1 + ((baseAxisMax - 1) * i) / 4;
        const ay = lerp(groundY, padT + 12 * dpr, i / 4);
        ctx.fillText(`${val.toFixed(1)}x`, padL - 8 * dpr, ay + 3 * dpr);
      }

      const plotW = w - padL - padR, plotH = groundY - padT;
      let px = padL + 54 * dpr, py = groundY - 18 * dpr, pang = -0.04;
      if (phase === 'BETTING') {
        py = groundY - 16 * dpr + Math.sin(now * 0.004) * 1.2 * dpr; pang = -0.03;
      } else if (phase === 'TAKEOFF') {
        const ez = takeoffProg * takeoffProg, lift = Math.max(0, (takeoffProg - 0.55) / 0.45);
        px = padL + (54 + ez * Math.min(110, plotW * 0.24)) * dpr;
        py = groundY - 16 * dpr - lift * lift * 28 * dpr; pang = -0.03 - lift * 0.26;
      } else if (phase === 'FLYING') {
        const ts = flightElapsed / 1000, nx = Math.min(0.84, 1 - Math.exp(-ts * 0.22)), ny = Math.min(0.82, Math.pow(nx, 1.32) * 0.92);
        px = padL + 95 * dpr + nx * (plotW - 140 * dpr);
        py = groundY - 22 * dpr - ny * (plotH - 38 * dpr) + Math.sin(now * 0.0055) * 6 * dpr;
        pang = -0.26 - Math.sin(now * 0.004) * 0.04;
        const sx = padL + 70 * dpr, sy = groundY - 10 * dpr, cx = lerp(sx, px, 0.58), cy = lerp(sy, py, 0.16);
        const ag = ctx.createLinearGradient(0, py, 0, groundY);
        ag.addColorStop(0, 'rgba(225,29,72,0.34)'); ag.addColorStop(0.65, 'rgba(245,158,11,0.12)'); ag.addColorStop(1, 'rgba(225,29,72,0)');
        ctx.beginPath(); ctx.moveTo(sx, groundY); ctx.lineTo(sx, sy); ctx.quadraticCurveTo(cx, cy, px, py); ctx.lineTo(px, groundY); ctx.closePath(); ctx.fillStyle = ag; ctx.fill();
        const lg = ctx.createLinearGradient(sx, sy, px, py);
        lg.addColorStop(0, '#f59e0b'); lg.addColorStop(0.5, '#f43f5e'); lg.addColorStop(1, '#fff');
        ctx.shadowColor = 'rgba(244,63,94,0.8)'; ctx.shadowBlur = 12 * dpr; ctx.strokeStyle = lg; ctx.lineWidth = 3.6 * dpr;
        ctx.beginPath(); ctx.moveTo(sx, sy); ctx.quadraticCurveTo(cx, cy, px, py); ctx.stroke(); ctx.shadowBlur = 0;
        if (Math.random() < 0.65) particles.push({ x: px - 24 * dpr, y: py + 4 * dpr, vx: (-75 - Math.random() * 45) * dpr, vy: (12 + (Math.random() - 0.5) * 20) * dpr, r: (2.2 + Math.random() * 3.2) * dpr, life: 0, max: 0.45 + Math.random() * 0.35 });
      } else {
        const tf = Math.min(1, crashElapsed / 950), ef = tf * tf;
        const ts = flightElapsed / 1000, nx = Math.min(0.84, 1 - Math.exp(-ts * 0.22)), ny = Math.min(0.82, Math.pow(nx, 1.32) * 0.92);
        px = (padL + 95 * dpr + nx * (plotW - 140 * dpr)) + ef * w * 0.55;
        py = (groundY - 22 * dpr - ny * (plotH - 38 * dpr)) - ef * h * 0.48;
        pang = -0.35 - ef * 0.25;
      }

      particles = particles.filter((p) => {
        p.life += dt; if (p.life >= p.max) return false;
        p.x += p.vx * dt; p.y += p.vy * dt;
        ctx.fillStyle = `rgba(226,232,240,${(1 - p.life / p.max) * 0.45})`;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r * (1 + p.life * 1.4), 0, Math.PI * 2); ctx.fill();
        return true;
      });

      if (px < w + 120 * dpr && py > -120 * dpr) {
        const pScale = Math.max(0.75, Math.min(1.15, w / (780 * dpr))) * dpr;
        drawBiplane(px, py, pang, pScale, (now * 0.001 * (phase === 'BETTING' ? 18 : 48)) % (Math.PI * 2), (now * 0.015) % (Math.PI * 2));
      }

      requestAnimationFrame(loop);
    }
    requestAnimationFrame(loop);
  })();
  </script>
