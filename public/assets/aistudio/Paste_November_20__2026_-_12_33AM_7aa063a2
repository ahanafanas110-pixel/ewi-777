  <script>
  (function () {
    // --- Boot Loader ---
    const loaderEl = document.getElementById('boot-loader');
    const loaderFill = document.getElementById('loader-fill');
    const loaderPct = document.getElementById('loader-pct');
    let loaderStart = performance.now();

    function hideLoader() {
      loaderEl.classList.add('hidden');
      setTimeout(() => { loaderEl.style.display = 'none'; }, 300);
    }
    loaderEl.addEventListener('click', hideLoader);

    function stepLoader(now) {
      const t = Math.min(1, (now - loaderStart) / 900);
      const pct = Math.round(12 + (1 - Math.pow(1 - t, 3)) * 88);
      loaderFill.style.width = pct + '%';
      loaderPct.textContent = 'Preparing Runway · ' + pct + '%';
      if (t < 1) requestAnimationFrame(stepLoader);
      else setTimeout(hideLoader, 200);
    }
    requestAnimationFrame(stepLoader);

    // --- Web Audio Engine ---
    const Sound = {
      ctx: null,
      muted: localStorage.getItem('rb_muted') === 'true',
      engOsc: null,
      engGain: null,
      ensure() {
        if (this.muted) return null;
        if (!this.ctx) {
          const AC = window.AudioContext || window.webkitAudioContext;
          if (AC) this.ctx = new AC();
        }
        if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume().catch(() => {});
        return this.ctx;
      },
      playClick() {
        const c = this.ensure(); if (!c) return;
        const n = c.currentTime, o = c.createOscillator(), g = c.createGain();
        o.type = 'triangle'; o.frequency.setValueAtTime(520, n);
        o.frequency.exponentialRampToValueAtTime(240, n + 0.045);
        g.gain.setValueAtTime(0.06, n); g.gain.exponentialRampToValueAtTime(0.001, n + 0.045);
        o.connect(g); g.connect(c.destination); o.start(n); o.stop(n + 0.05);
      },
      playBet() {
        const c = this.ensure(); if (!c) return;
        const n = c.currentTime, o = c.createOscillator(), g = c.createGain();
        o.type = 'sine'; o.frequency.setValueAtTime(440, n);
        o.frequency.exponentialRampToValueAtTime(660, n + 0.09);
        g.gain.setValueAtTime(0.09, n); g.gain.exponentialRampToValueAtTime(0.001, n + 0.11);
        o.connect(g); g.connect(c.destination); o.start(n); o.stop(n + 0.12);
      },
      playTakeoff() {
        const c = this.ensure(); if (!c) return;
        this.stopHum();
        const n = c.currentTime, o = c.createOscillator(), f = c.createBiquadFilter(), g = c.createGain();
        o.type = 'sawtooth'; o.frequency.setValueAtTime(84, n);
        f.type = 'lowpass'; f.frequency.setValueAtTime(220, n);
        g.gain.setValueAtTime(0.001, n); g.gain.linearRampToValueAtTime(0.022, n + 0.4);
        o.connect(f); f.connect(g); g.connect(c.destination); o.start(n);
        this.engOsc = o; this.engGain = g;
      },
      updatePitch(m) {
        if (!this.engOsc || !this.ctx || this.muted) return;
        const freq = 84 + Math.log2(Math.max(1, Math.min(30, m))) * 22;
        this.engOsc.frequency.setTargetAtTime(freq, this.ctx.currentTime, 0.08);
      },
      stopHum() {
        if (this.engGain && this.ctx) {
          try { this.engGain.gain.setTargetAtTime(0.0001, this.ctx.currentTime, 0.05); } catch {}
        }
        if (this.engOsc) {
          const ref = this.engOsc;
          setTimeout(() => { try { ref.stop(); ref.disconnect(); } catch {} }, 140);
        }
        this.engOsc = null; this.engGain = null;
      },
      playCashOut() {
        const c = this.ensure(); if (!c) return;
        const n = c.currentTime;
        [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => {
          const o = c.createOscillator(), g = c.createGain(), t = n + i * 0.045;
          o.type = 'sine'; o.frequency.setValueAtTime(f, t);
          g.gain.setValueAtTime(0.001, t); g.gain.linearRampToValueAtTime(0.08, t + 0.015);
          g.gain.exponentialRampToValueAtTime(0.001, t + 0.24);
          o.connect(g); g.connect(c.destination); o.start(t); o.stop(t + 0.25);
        });
      },
      playFlyAway() {
        this.stopHum();
        const c = this.ensure(); if (!c) return;
        const n = c.currentTime, o = c.createOscillator(), g = c.createGain();
        o.type = 'triangle'; o.frequency.setValueAtTime(310, n);
        o.frequency.exponentialRampToValueAtTime(85, n + 0.42);
        g.gain.setValueAtTime(0.09, n); g.gain.exponentialRampToValueAtTime(0.001, n + 0.45);
        o.connect(g); g.connect(c.destination); o.start(n); o.stop(n + 0.46);
      }
    };

    // --- Game State ---
    const BETTING_MS = 5200, TAKEOFF_MS = 850, CRASHED_MS = 2900, GROWTH = 0.072;
    const PILOTS = ['AceViper','SkyHawk88','Baroness_K','Maverick77','SpitfireX','CloudNine','ZeppelinPro','NightWing','FalconEye','RedHawk','AeroKing','BlitzPilot','StormChaser','CrimsonAce','JetStream','Valkyrie','HighRoller9','Wingman_Z','PropellerX','SilverFox'];
    const COLORS = ['#e11d48','#f59e0b','#10b981','#3b82f6','#8b5cf6','#ec4899','#06b6d4'];

    function genCrashPoint() {
      const r = Math.random();
      if (r < 0.03) return 1.00;
      const raw = Math.min(20000, Math.max(1.01, 0.97 / (1 - r)));
      return Math.floor(raw * 100) / 100;
    }

    function genBots(cp) {
      const count = 14 + Math.floor(Math.random() * 7);
      const stakes = [1, 2, 5, 10, 15, 20, 25, 50, 75, 100, 150, 250, 500];
      return [...PILOTS].sort(() => Math.random() - 0.5).slice(0, count).map((name, i) => {
        const stake = stakes[Math.floor(Math.random() * stakes.length)];
        const r = Math.random();
        const target = r < 0.55 ? +(1.2 + Math.random() * 1.9).toFixed(2)
                     : r < 0.88 ? +(3.1 + Math.random() * 6.5).toFixed(2)
                     : +(10 + Math.random() * 35).toFixed(2);
        return {
          name, color: COLORS[i % COLORS.length], stake,
          target: (target <= cp || Math.random() < 0.85) ? target : null,
          cashedAt: null, payout: null
        };
      });
    }

    let balance = parseFloat(localStorage.getItem('rb_balance'));
    if (isNaN(balance) || balance < 0) balance = 2500.0;

    let phase = 'BETTING';
    let phaseStart = performance.now();
    let roundId = 48202;
    let crashPoint = genCrashPoint();
    let multiplier = 1.0;
    let flightElapsed = 0;
    let crashElapsed = 0;
    let takeoffProg = 0;
    let activeTab = 'all';

    const history = [2.41, 1.18, 6.72, 1.85, 14.35, 1.04, 3.19, 2.07, 1.44, 28.60, 1.62, 4.91, 1.00, 2.88, 9.14, 1.33, 5.40, 1.92, 3.75, 1.25]
      .map((cp, i) => ({ roundId: 48201 - i, cp }));
    const myBets = [];
    let bots = genBots(crashPoint);

    const slots = [
      { id: 0, stake: 10, mode: 'manual', status: 'IDLE', autoCash: false, target: 2.0, autoBet: false, roundsLeft: 0, selRounds: 10, cashedMult: null, payout: null },
      { id: 1, stake: 25, mode: 'manual', status: 'IDLE', autoCash: true, target: 3.5, autoBet: false, roundsLeft: 0, selRounds: 10, cashedMult: null, payout: null },
      { id: 2, stake: 5,  mode: 'manual', status: 'IDLE', autoCash: true, target: 10.0, autoBet: false, roundsLeft: 0, selRounds: 10, cashedMult: null, payout: null },
    ];

    const balDisplay = document.getElementById('balance-display');
    const modalBalDisplay = document.getElementById('modal-balance');
    const roundLabel = document.getElementById('round-label');
    const phaseLabel = document.getElementById('phase-label');
    const stageHud = document.getElementById('stage-hud');
    const winPopupsEl = document.getElementById('win-popups');
    const betsGrid = document.getElementById('bets-grid');
    const historyPills = document.getElementById('history-pills');
    const historyDrawer = document.getElementById('history-drawer');
    const historyDrawerGrid = document.getElementById('history-drawer-grid');
    const feedList = document.getElementById('feed-list');
    const pilotsCount = document.getElementById('pilots-count');
    const totalPot = document.getElementById('total-pot');
    const muteBtn = document.getElementById('btn-mute');

    muteBtn.textContent = Sound.muted ? '🔇' : '🔊';
    muteBtn.addEventListener('click', () => {
      Sound.muted = !Sound.muted;
      localStorage.setItem('rb_muted', String(Sound.muted));
      if (Sound.muted) Sound.stopHum();
      muteBtn.textContent = Sound.muted ? '🔇' : '🔊';
    });

    function setBalance(val) {
      balance = +Math.max(0, val).toFixed(2);
      localStorage.setItem('rb_balance', balance.toFixed(2));
      balDisplay.textContent = balance.toFixed(2);
      modalBalDisplay.textContent = '€' + balance.toFixed(2);
    }
    setBalance(balance);

    document.getElementById('btn-rules').addEventListener('click', () => { Sound.playClick(); document.getElementById('modal-rules').classList.add('open'); });
    document.getElementById('btn-wallet').addEventListener('click', () => { Sound.playClick(); document.getElementById('modal-wallet').classList.add('open'); });
    document.querySelectorAll('[data-close]').forEach((b) => {
      b.addEventListener('click', () => document.getElementById(b.dataset.close).classList.remove('open'));
    });
    document.querySelectorAll('.modal-backdrop').forEach((m) => {
      m.addEventListener('click', (e) => { if (e.target === m) m.classList.remove('open'); });
    });
    document.querySelectorAll('[data-topup]').forEach((b) => {
      b.addEventListener('click', () => { Sound.playBet(); setBalance(balance + Number(b.dataset.topup)); renderBetCards(); });
    });
    document.getElementById('btn-reset-bal').addEventListener('click', () => { Sound.playClick(); setBalance(2500); renderBetCards(); });

    document.getElementById('btn-expand-history').addEventListener('click', () => {
      Sound.playClick();
      historyDrawer.classList.toggle('open');
    });

    document.querySelectorAll('.tab-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        Sound.playClick();
        activeTab = btn.dataset.tab;
        document.querySelectorAll('.tab-btn').forEach((t) => t.classList.toggle('active', t === btn));
        renderSidebar();
      });
    });

    function pillClass(cp) {
      if (cp >= 10) return 'pill-high';
      if (cp >= 2) return 'pill-mid';
      return 'pill-low';
    }

    function renderHistory() {
      historyPills.innerHTML = history.slice(0, 18).map((h, i) =>
        `<span class="pill ${pillClass(h.cp)} ${i === 0 ? 'pill-latest' : ''}">${h.cp.toFixed(2)}x</span>`
      ).join('');
      historyDrawerGrid.innerHTML = history.slice(0, 40).map((h) =>
        `<span class="pill ${pillClass(h.cp)}">${h.cp.toFixed(2)}x</span>`
      ).join('');
    }

    function pushPopup(slotId, amount, mult) {
      const div = document.createElement('div');
      div.className = 'win-toast tabular-nums';
      div.innerHTML = `<span style="background:rgba(2,6,23,0.2);padding:2px 6px;border-radius:5px;font-size:10px;">BET ${slotId + 1}</span><span>+€${amount.toFixed(2)}</span><span style="font-family:var(--font-mono);font-size:11px;opacity:0.85;">@${mult.toFixed(2)}x</span>`;
      winPopupsEl.appendChild(div);
      setTimeout(() => div.remove(), 2500);
    }

    function cashOutSlot(slotId, atMult) {
      if (phase !== 'FLYING') return;
      const s = slots[slotId];
      if (s.status !== 'FLYING') return;
      const m = atMult || multiplier;
      const payout = +(s.stake * m).toFixed(2);
      Sound.playCashOut();
      setBalance(balance + payout);
      s.status = 'CASHED';
      s.cashedMult = m;
      s.payout = payout;
      myBets.unshift({ roundId, slotId, stake: s.stake, mult: m, payout, cp: crashPoint, won: true });
      if (myBets.length > 50) myBets.pop();
      pushPopup(slotId, payout, m);
      renderBetCards();
      renderSidebar();
    }

    function handleSlotAction(slotId) {
      const s = slots[slotId];
      if (phase === 'FLYING' && s.status === 'FLYING') {
        cashOutSlot(slotId);
        return;
      }
      if (s.status === 'PLACED' || s.status === 'QUEUED') {
        Sound.playClick();
        setBalance(balance + s.stake);
        s.status = 'IDLE';
        renderBetCards();
        return;
      }
      if (s.stake <= 0 || s.stake > balance) return;
      Sound.playBet();
      setBalance(balance - s.stake);
      s.status = phase === 'BETTING' ? 'PLACED' : 'QUEUED';
      s.cashedMult = null;
      s.payout = null;
      renderBetCards();
    }

    function initBetCards() {
      betsGrid.innerHTML = slots.map((s) => `
        <div class="bet-card" id="bet-card-${s.id}">
          <div class="bet-head">
            <div style="display:flex;align-items:center;gap:8px;">
              <span class="slot-badge">Bet ${s.id + 1}</span>
              <span id="cashed-tag-${s.id}" class="tabular-nums" style="font-family:var(--font-mono);font-size:11px;font-weight:700;color:#34d399;"></span>
            </div>
            <div class="mode-switch">
              <button type="button" class="mode-btn ${s.mode === 'manual' ? 'active' : ''}" data-slot="${s.id}" data-mode="manual">Manual</button>
              <button type="button" class="mode-btn ${s.mode === 'auto' ? 'active' : ''}" data-slot="${s.id}" data-mode="auto">Auto</button>
            </div>
          </div>
          <div class="bet-body">
            <div class="bet-inputs">
              <div class="stepper">
                <button type="button" class="step-btn" data-slot="${s.id}" data-step="-1">−</button>
                <div class="stake-input-wrap">
                  <span style="font-size:12px;color:#94a3b8;">€</span>
                  <input type="number" class="stake-input tabular-nums" id="stake-in-${s.id}" value="${s.stake}" min="0.1" max="1000" step="0.5" />
                </div>
                <button type="button" class="step-btn" data-slot="${s.id}" data-step="1">+</button>
              </div>
              <div class="chips-row">
                ${[1,5,25,100].map((c) => `<button type="button" class="chip-btn" data-slot="${s.id}" data-chip="${c}">${c}</button>`).join('')}
                <button type="button" class="chip-btn" data-slot="${s.id}" data-mod="half">½</button>
                <button type="button" class="chip-btn" data-slot="${s.id}" data-mod="dbl">2×</button>
              </div>
            </div>
            <button type="button" class="action-btn btn-bet" id="action-btn-${s.id}">
              <span class="action-title" id="action-title-${s.id}">BET</span>
              <span class="action-sub tabular-nums" id="action-sub-${s.id}">€${s.stake.toFixed(2)}</span>
            </button>
          </div>
          <div class="bet-foot">
            <div style="display:flex;align-items:center;gap:8px;">
              <button type="button" class="auto-toggle ${s.autoCash ? 'on' : ''}" id="autocash-btn-${s.id}">⚡ Auto Cash Out</button>
              <div class="target-box">
                <input type="number" class="target-input tabular-nums" id="target-in-${s.id}" value="${s.target}" min="1.01" max="10000" step="0.1" ${s.autoCash ? '' : 'disabled'} />
                <span style="font-size:11px;color:#94a3b8;margin-left:2px;font-family:var(--font-mono);">x</span>
              </div>
            </div>
            <div class="autobet-controls ${s.mode === 'auto' ? 'visible' : ''}" id="autobet-ctrl-${s.id}">
              <select class="rounds-select" id="rounds-sel-${s.id}">
                <option value="5">5x</option>
                <option value="10" selected>10x</option>
                <option value="25">25x</option>
                <option value="0">∞</option>
              </select>
              <button type="button" class="autobet-btn" id="autobet-btn-${s.id}">Auto Bet</button>
            </div>
          </div>
        </div>
      `).join('');

      slots.forEach((s) => {
        const id = s.id;
        document.querySelectorAll(`[data-slot="${id}"][data-mode]`).forEach((b) => {
          b.addEventListener('click', () => {
            Sound.playClick();
            s.mode = b.dataset.mode;
            renderBetCards();
          });
        });
        document.querySelectorAll(`[data-slot="${id}"][data-step]`).forEach((b) => {
          b.addEventListener('click', () => {
            Sound.playClick();
            const dir = Number(b.dataset.step);
            const delta = s.stake >= 10 ? 5 * dir : 1 * dir;
            s.stake = Math.max(0.1, Math.min(1000, +(s.stake + delta).toFixed(2)));
            document.getElementById(`stake-in-${id}`).value = s.stake;
            renderBetCards();
          });
        });
        document.querySelectorAll(`[data-slot="${id}"][data-chip]`).forEach((b) => {
          b.addEventListener('click', () => {
            Sound.playClick();
            s.stake = Number(b.dataset.chip);
            document.getElementById(`stake-in-${id}`).value = s.stake;
            renderBetCards();
          });
        });
        document.querySelectorAll(`[data-slot="${id}"][data-mod]`).forEach((b) => {
          b.addEventListener('click', () => {
            Sound.playClick();
            const next = b.dataset.mod === 'half' ? s.stake / 2 : s.stake * 2;
            s.stake = Math.max(0.1, Math.min(1000, +next.toFixed(2)));
            document.getElementById(`stake-in-${id}`).value = s.stake;
            renderBetCards();
          });
        });
        document.getElementById(`stake-in-${id}`).addEventListener('input', (e) => {
          const v = parseFloat(e.target.value);
          if (!isNaN(v)) {
            s.stake = Math.max(0.1, Math.min(1000, v));
            renderBetCards(true);
          }
        });
        document.getElementById(`action-btn-${id}`).addEventListener('click', () => handleSlotAction(id));
        document.getElementById(`autocash-btn-${id}`).addEventListener('click', () => {
          Sound.playClick();
          s.autoCash = !s.autoCash;
          renderBetCards();
        });
        document.getElementById(`target-in-${id}`).addEventListener('input', (e) => {
          const v = parseFloat(e.target.value);
          if (!isNaN(v)) s.target = Math.max(1.01, Math.min(10000, v));
        });
        document.getElementById(`rounds-sel-${id}`).addEventListener('change', (e) => {
          s.selRounds = Number(e.target.value);
        });
        document.getElementById(`autobet-btn-${id}`).addEventListener('click', () => {
          Sound.playClick();
          if (!s.autoBet) {
            s.autoBet = true;
            s.roundsLeft = s.selRounds;
            if ((s.status === 'IDLE' || s.status === 'CASHED' || s.status === 'LOST') && s.stake <= balance) {
              setBalance(balance - s.stake);
              s.status = phase === 'BETTING' ? 'PLACED' : 'QUEUED';
            }
          } else {
            s.autoBet = false;
            s.roundsLeft = 0;
          }
          renderBetCards();
        });
      });
    }

    function renderBetCards(skipInputSync) {
      slots.forEach((s) => {
        const card = document.getElementById(`bet-card-${s.id}`);
        const locked = s.status === 'PLACED' || s.status === 'QUEUED' || s.status === 'FLYING' || s.autoBet;

        card.className = 'bet-card' +
          (s.status === 'FLYING' ? ' st-flying' :
           s.status === 'CASHED' ? ' st-cashed' :
           (s.status === 'PLACED' || s.status === 'QUEUED') ? ' st-placed' : '');

        document.getElementById(`cashed-tag-${s.id}`).textContent =
          (s.status === 'CASHED' && s.cashedMult) ? `@${s.cashedMult.toFixed(2)}x` : '';

        document.querySelectorAll(`[data-slot="${s.id}"][data-mode]`).forEach((b) => {
          b.classList.toggle('active', b.dataset.mode === s.mode);
        });

        const stakeIn = document.getElementById(`stake-in-${s.id}`);
        stakeIn.disabled = locked;
        if (!skipInputSync) stakeIn.value = s.stake;

        document.querySelectorAll(`[data-slot="${s.id}"][data-step], [data-slot="${s.id}"][data-chip], [data-slot="${s.id}"][data-mod]`)
          .forEach((b) => {
            b.disabled = locked;
            if (b.dataset.chip) b.classList.toggle('selected', Number(b.dataset.chip) === s.stake);
          });

        const acBtn = document.getElementById(`autocash-btn-${s.id}`);
        acBtn.classList.toggle('on', s.autoCash);
        document.getElementById(`target-in-${s.id}`).disabled = !s.autoCash;

        document.getElementById(`autobet-ctrl-${s.id}`).classList.toggle('visible', s.mode === 'auto');
        document.getElementById(`rounds-sel-${s.id}`).style.display = s.autoBet ? 'none' : 'inline-block';
        const abBtn = document.getElementById(`autobet-btn-${s.id}`);
        abBtn.classList.toggle('active', s.autoBet);
        abBtn.textContent = s.autoBet ? `Stop (${s.roundsLeft === 0 ? '∞' : s.roundsLeft})` : 'Auto Bet';

        const btn = document.getElementById(`action-btn-${s.id}`);
        const title = document.getElementById(`action-title-${s.id}`);
        const sub = document.getElementById(`action-sub-${s.id}`);
        const lowFunds = (s.status === 'IDLE' || s.status === 'CASHED' || s.status === 'LOST') && s.stake > balance;

        btn.disabled = false;
        if (phase === 'FLYING' && s.status === 'FLYING') {
          btn.className = 'action-btn btn-cashout';
          title.textContent = 'CASH OUT';
          sub.textContent = `€${(s.stake * multiplier).toFixed(2)}`;
        } else if (s.status === 'PLACED') {
          if (phase === 'BETTING') {
            btn.className = 'action-btn btn-cancel';
            title.textContent = 'CANCEL';
            sub.textContent = 'Bet Locked';
          } else {
            btn.className = 'action-btn btn-locked';
            btn.disabled = true;
            title.textContent = 'IN FLIGHT';
            sub.textContent = `€${s.stake.toFixed(2)}`;
          }
        } else if (s.status === 'QUEUED') {
          btn.className = 'action-btn btn-cancel';
          title.textContent = 'CANCEL';
          sub.textContent = 'Queued Next';
        } else if (lowFunds) {
          btn.className = 'action-btn btn-locked';
          btn.disabled = true;
          title.textContent = 'LOW FUNDS';
          sub.textContent = 'Top Up';
        } else if (phase !== 'BETTING') {
          btn.className = 'action-btn btn-bet';
          title.textContent = 'BET NEXT';
          sub.textContent = (s.status === 'CASHED' && s.payout !== null) ? `Won €${s.payout.toFixed(2)}` : `€${s.stake.toFixed(2)}`;
        } else {
          btn.className = 'action-btn btn-bet';
          title.textContent = 'BET';
          sub.textContent = `€${s.stake.toFixed(2)}`;
        }
      });
    }

    function renderSidebar() {
      const total = bots.reduce((a, b) => a + b.stake, 0);
      const cashed = bots.filter((b) => b.cashedAt !== null).length;
      pilotsCount.innerHTML = `${bots.length}` + (cashed > 0 ? ` <span style="color:#34d399;">(${cashed} cashed)</span>` : '');
      totalPot.textContent = `€${total.toLocaleString()}`;

      if (activeTab === 'all') {
